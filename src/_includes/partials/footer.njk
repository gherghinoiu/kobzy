<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/assets/img/logo-mono.svg" alt="{{ site.name }}" width="120" height="31" />
      <p>{{ site.description }}</p>
      <p class="footer-area">{{ site.location.serviceArea }}</p>
    </div>

    <div class="footer-col">
      <h3>Explore</h3>
      <a href="/">Home</a>
      <a href="/#stock">Our Cars</a>
      <a href="/about/">About Us</a>
      <a href="/contact/">Contact</a>
    </div>

    <div class="footer-col">
      <h3>Get in touch</h3>
      <a href="tel:{{ site.contact.phoneLink }}">{{ site.contact.phoneDisplay }}</a>
      <a href="https://wa.me/{{ site.contact.whatsapp }}?text={{ site.contact.whatsappMessage | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
      {% if site.contact.email %}<a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}
    </div>

    <div class="footer-col">
      <h3>Opening hours</h3>
      {% for h in site.hours %}
        <p><span>{{ h.days }}</span><br>{{ h.time }}</p>
      {% endfor %}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {{ site.buildYear }} {{ site.name }}. All rights reserved.</p>
    <p class="disclaimer">All vehicles sold subject to availability. Details believed correct at time of listing — please confirm before travelling.</p>
  </div>
</footer>

{# Floating WhatsApp button (mobile-first quick contact) #}
<a class="whatsapp-fab" href="https://wa.me/{{ site.contact.whatsapp }}?text={{ site.contact.whatsappMessage | urlencode }}" target="_blank" rel="noopener" aria-label="Message us on WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
